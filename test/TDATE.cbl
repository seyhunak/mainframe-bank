>>SOURCE FORMAT FREE
      *> Unit test for MBDATE against independently computed references.
IDENTIFICATION DIVISION.
PROGRAM-ID. TDATE.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY DATECOMM.
01  PASS-N PIC 99 COMP VALUE 0.
01  FAIL-N PIC 99 COMP VALUE 0.
01  A       PIC 9(8).
01  B       PIC 9(8).
01  N       PIC S9(9) COMP-3.
01  N2      PIC S9(9) COMP-3.
01  R       PIC S9(9) COMP-3.
01  IN1     PIC X(8).
01  IN2     PIC X(8).
01  FN      PIC X(4).
01  LBL     PIC X(28).
PROCEDURE DIVISION.
MAIN.
    PERFORM T-ORD
    PERFORM T-DOW
    PERFORM T-EOM
    PERFORM T-DAYSIN
    PERFORM T-AMON
    PERFORM T-ADAY
    PERFORM T-DBTW
    PERFORM T-VALID
    PERFORM T-NBBU
    DISPLAY " "
    DISPLAY " MBDATE TESTS  PASS=" PASS-N "  FAIL=" FAIL-N
    GOBACK.

      *> ---- date -> ordinal via DAYS-BETWEEN against 19700101 -----------
T-ORD.
    MOVE "ORD (19700101 - 20261006) = -20732" TO LBL
    PERFORM RUN-ORD
    MOVE -20732 TO N
    PERFORM CHK-NUM.

RUN-ORD.
    MOVE 20261006 TO A MOVE 19700101 TO B
    MOVE 0 TO R
    PERFORM DBTW-PARA.

DBTW-PARA.
    MOVE DF-DBTW TO DT-FUNC
    MOVE A TO DT-IN1
    MOVE B TO DT-IN2
    CALL "MBDATE" USING DTECOMM
    MOVE DT-OUT-NUM TO R.

      *> ---- day of week, Sun=1 ------------------------------------------
T-DOW.
    MOVE "DOW 19700101 = Thu(5)" TO LBL
    MOVE 19700101 TO A
    PERFORM DOW-PARA
    MOVE 5 TO N
    PERFORM CHK-NUM.
    MOVE "DOW 20261006 = Tue(3)" TO LBL
    MOVE 20261006 TO A
    PERFORM DOW-PARA
    MOVE 3 TO N
    PERFORM CHK-NUM.
    MOVE "DOW 20260228 = Sat(7)" TO LBL
    MOVE 20260228 TO A
    PERFORM DOW-PARA
    MOVE 7 TO N
    PERFORM CHK-NUM.
    MOVE "DOW 20000229 = Tue(3)" TO LBL
    MOVE 20000229 TO A
    PERFORM DOW-PARA
    MOVE 3 TO N
    PERFORM CHK-NUM.

DOW-PARA.
    MOVE DF-DOW TO DT-FUNC
    MOVE A TO DT-IN1
    CALL "MBDATE" USING DTECOMM
    MOVE DT-OUT-NUM TO R.

      *> ---- end of month ------------------------------------------------
T-EOM.
    MOVE "EOM 202402 = 29" TO LBL
    MOVE 20240215 TO A
    PERFORM EOM-PARA
    MOVE 20240229 TO N
    PERFORM CHK-N.
    MOVE "EOM 202602 = 28" TO LBL
    MOVE 20260215 TO A
    PERFORM EOM-PARA
    MOVE 20260228 TO N
    PERFORM CHK-N.
    MOVE "EOM 202612 = 31" TO LBL
    MOVE 20261201 TO A
    PERFORM EOM-PARA
    MOVE 20261231 TO N
    PERFORM CHK-N.

EOM-PARA.
    MOVE DF-EOM TO DT-FUNC
    MOVE A TO DT-IN1
    CALL "MBDATE" USING DTECOMM
    MOVE DT-OUT TO R.

      *> ---- days in month ------------------------------------------------
T-DAYSIN.
    MOVE "DIM 202402 = 29" TO LBL
    MOVE 20240201 TO A
    PERFORM DIM-PARA
    MOVE 29 TO N
    PERFORM CHK-N.
    MOVE "DIM 190002 = 28" TO LBL
    MOVE 19000201 TO A
    PERFORM DIM-PARA
    MOVE 28 TO N
    PERFORM CHK-N.
    MOVE "DIM 200002 = 29" TO LBL
    MOVE 20000201 TO A
    PERFORM DIM-PARA
    MOVE 29 TO N
    PERFORM CHK-N.

DIM-PARA.
    MOVE DF-DMON TO DT-FUNC
    MOVE A TO DT-IN1
    CALL "MBDATE" USING DTECOMM
    MOVE DT-OUT-NUM TO R.

      *> ---- add months with day clamping ---------------------------------
T-AMON.
    MOVE "AMON 20260131+1 = 20260228" TO LBL
    MOVE 20260131 TO A MOVE 1 TO N2
    PERFORM AMON-PARA
    MOVE 20260228 TO N
    PERFORM CHK-N.
    MOVE "AMON 20260131+13 = 20270228" TO LBL
    MOVE 20260131 TO A MOVE 13 TO N2
    PERFORM AMON-PARA
    MOVE 20270228 TO N
    PERFORM CHK-N.
    MOVE "AMON 20240831+1 = 20240930" TO LBL
    MOVE 20240831 TO A MOVE 1 TO N2
    PERFORM AMON-PARA
    MOVE 20240930 TO N
    PERFORM CHK-N.
    MOVE "AMON 20240831+5 = 20250131" TO LBL
    MOVE 20240831 TO A MOVE 5 TO N2
    PERFORM AMON-PARA
    MOVE 20250131 TO N
    PERFORM CHK-N.

AMON-PARA.
    MOVE DF-AMON TO DT-FUNC
    MOVE A TO DT-IN1
    MOVE N2 TO DT-IN-NUM
    CALL "MBDATE" USING DTECOMM
    MOVE DT-OUT TO R.

      *> ---- add days ------------------------------------------------------
T-ADAY.
    MOVE "ADAY 20261231+1 = 20270101" TO LBL
    MOVE 20261231 TO A MOVE 1 TO N2
    PERFORM ADAY-PARA
    MOVE 20270101 TO N
    PERFORM CHK-N.
    MOVE "ADAY 20260228+1 = 20260301" TO LBL
    MOVE 20260228 TO A MOVE 1 TO N2
    PERFORM ADAY-PARA
    MOVE 20260301 TO N
    PERFORM CHK-N.
    MOVE "ADAY 20240229+1 = 20240301" TO LBL
    MOVE 20240229 TO A MOVE 1 TO N2
    PERFORM ADAY-PARA
    MOVE 20240301 TO N
    PERFORM CHK-N.
    MOVE "ADAY 20261006-45 = 20260822" TO LBL
    MOVE 20261006 TO A MOVE -45 TO N2
    PERFORM ADAY-PARA
    MOVE 20260822 TO N
    PERFORM CHK-N.
    MOVE "ADAY 19000101+1 = 19000102" TO LBL
    MOVE 19000101 TO A MOVE 1 TO N2
    PERFORM ADAY-PARA
    MOVE 19000102 TO N
    PERFORM CHK-N.

ADAY-PARA.
    MOVE DF-ADAY TO DT-FUNC
    MOVE A TO DT-IN1
    MOVE N2 TO DT-IN-NUM
    CALL "MBDATE" USING DTECOMM
    MOVE DT-OUT TO R.

      *> ---- days between, negative direction -------------------------------
T-DBTW.
    MOVE "DBTW 20260101->20261231=364" TO LBL
    MOVE 20260101 TO A MOVE 20261231 TO B
    PERFORM DBTW-PARA
    MOVE 364 TO N
    PERFORM CHK-N.
    MOVE "DBTW reverse = -364" TO LBL
    MOVE 20261231 TO A MOVE 20260101 TO B
    PERFORM DBTW-PARA
    MOVE -364 TO N
    PERFORM CHK-N.
    MOVE "DBTW 19000101->19700101=25567" TO LBL
    MOVE 19000101 TO A MOVE 19700101 TO B
    PERFORM DBTW-PARA
    MOVE 25567 TO N
    PERFORM CHK-N.

      *> ---- validation -----------------------------------------------------
T-VALID.
    MOVE "VALD 20260229 must FAIL" TO LBL
    MOVE 20260229 TO A
    PERFORM VAL-PARA
    MOVE 14 TO N
    PERFORM CHK-N.
    MOVE "VALD 19000229 must FAIL" TO LBL
    MOVE 19000229 TO A
    PERFORM VAL-PARA
    MOVE 14 TO N
    PERFORM CHK-N.
    MOVE "VALD 20260431 must FAIL" TO LBL
    MOVE 20260431 TO A
    PERFORM VAL-PARA
    MOVE 14 TO N
    PERFORM CHK-N.
    MOVE "VALD 20261301 must FAIL" TO LBL
    MOVE 20261301 TO A
    PERFORM VAL-PARA
    MOVE 13 TO N
    PERFORM CHK-N.
    MOVE "VALD 20260228 must PASS" TO LBL
    MOVE 20260228 TO A
    PERFORM VAL-PARA
    MOVE 0 TO N
    PERFORM CHK-N.

VAL-PARA.
    MOVE DF-VALID TO DT-FUNC
    MOVE A TO DT-IN1
    CALL "MBDATE" USING DTECOMM
    MOVE DT-RC TO R.

      *> ---- next business day ----------------------------------------------
T-NBBU.
    MOVE "NBBU 20261003(Sat) = 20261005" TO LBL
    MOVE 20261003 TO A
    PERFORM NBB-PARA
    MOVE 20261005 TO N
    PERFORM CHK-N.
    MOVE "NBBU 20261004(Sun) = 20261005" TO LBL
    MOVE 20261004 TO A
    PERFORM NBB-PARA
    MOVE 20261005 TO N
    PERFORM CHK-N.
    MOVE "NBBU 20261006(Tue)= 20261006" TO LBL
    MOVE 20261006 TO A
    PERFORM NBB-PARA
    MOVE 20261006 TO N
    PERFORM CHK-N.

NBB-PARA.
    MOVE DF-NXTBUS TO DT-FUNC
    MOVE A TO DT-IN1
    CALL "MBDATE" USING DTECOMM
    MOVE DT-OUT TO R.

      *> ---- assertions ---------------------------------------------------
CHK-N.
    IF R = N
        ADD 1 TO PASS-N
    ELSE
        ADD 1 TO FAIL-N
        DISPLAY " FAIL " LBL "  got=" R " want=" N
    END-IF.

CHK-NUM.
    IF R = N
        ADD 1 TO PASS-N
    ELSE
        ADD 1 TO FAIL-N
        DISPLAY " FAIL " LBL "  got=" R " want=" N
    END-IF.
