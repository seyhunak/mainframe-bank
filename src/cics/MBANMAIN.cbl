>>SOURCE FORMAT FREE
      *> ====================================================================
      *> MBANMAIN - Terminal transaction driver.
      *>
      *> Stands in for a CICS region: one long lived program that presents a
      *> menu, reads fields, and dispatches each request to the posting
      *> engine. Reads its own copies of the master datasets for inquiry;
      *> never writes a balance, which is MBPOSTNG's job alone.
      *>
      *> Run:  bin/TERMBANK
      *> ====================================================================
IDENTIFICATION DIVISION.
PROGRAM-ID. MBANMAIN.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT ACCT-FILE ASSIGN TO "data/ACCTFILE"
        ORGANIZATION IS INDEXED
        ACCESS MODE IS RANDOM
        RECORD KEY IS AC-NO
        FILE STATUS IS FS-ACCT.
    SELECT BAL-FILE ASSIGN TO "data/BALFILE"
        ORGANIZATION IS INDEXED
        ACCESS MODE IS RANDOM
        RECORD KEY IS BA-NO
        FILE STATUS IS FS-BAL.
    SELECT CUST-FILE ASSIGN TO "data/CUSTFILE"
        ORGANIZATION IS INDEXED
        ACCESS MODE IS RANDOM
        RECORD KEY IS CU-ID
        FILE STATUS IS FS-CUST.
    SELECT LOAN-FILE ASSIGN TO "data/LOANFILE"
        ORGANIZATION IS INDEXED
        ACCESS MODE IS RANDOM
        RECORD KEY IS LN-NO
        FILE STATUS IS FS-LOAN.
    SELECT LNBAL-FILE ASSIGN TO "data/LNBALFILE"
        ORGANIZATION IS INDEXED
        ACCESS MODE IS RANDOM
        RECORD KEY IS LB-NO
        FILE STATUS IS FS-LNBAL.

DATA DIVISION.
FILE SECTION.
FD  ACCT-FILE.
COPY ACCTREC.
FD  BAL-FILE.
COPY BALREC.
FD  CUST-FILE.
COPY CUSTREC.
FD  LOAN-FILE.
COPY LOANREC.
FD  LNBAL-FILE.
COPY LNBALREC.

WORKING-STORAGE SECTION.
COPY BANKCON.
COPY SCRCOMM.
COPY POSTCOMM.
COPY PARMCOMM.
COPY LOGCOMM.

01  FS-ACCT    PIC XX.
01  FS-BAL     PIC XX.
01  FS-CUST    PIC XX.
01  FS-LOAN    PIC XX.
01  FS-LNBAL   PIC XX.

01  W-CHOICE     PIC X.
01  W-DONE      PIC X VALUE "N".
01  W-ROW       PIC 99 COMP VALUE 0.
01  W-MSG1      PIC X(40).
      *> edit pictures sized for the 14 column money slots on the screen
      *> (a wider picture silently lost the cents before)
01  W-BALED     PIC -Z(9)9.99.
01  W-AMTED     PIC -Z(9)9.99.
01  W-LIMED     PIC -Z(9)9.99.
01  W-RATEED    PIC Z9.99999999.
01  W-AMT       PIC S9(13)V99 COMP-3.
01  W-INPCT     PIC S9(13)V99 COMP-3.
01  W-OUT       PIC X(80).
01  W-TYPE-NM   PIC X(12).
01  W-STATUS-NM PIC X(12).
01  W-YESNO     PIC X VALUE "N".
01  W-POSTED-OK PIC X VALUE "N".
01  W-NUM4       PIC 9(4).
01  W-PARM-NAME PIC X(12).

PROCEDURE DIVISION.
MAIN-PARA.
    DISPLAY "main: start"
    PERFORM SIGN-ON
    IF W-DONE = "Y"
        GOBACK
    END-IF
    PERFORM INIT-SESSION
    DISPLAY "main: session up"
    PERFORM PUT-SESSION-CONTEXT
    PERFORM UNTIL W-DONE = "Y"
        PERFORM SHOW-MENU
        PERFORM READ-CHOICE
        EVALUATE W-CHOICE
            WHEN "1" PERFORM DO-BALANCE
            WHEN "2" PERFORM DO-CUSTOMER
            WHEN "3" PERFORM DO-DEPOSIT
            WHEN "4" PERFORM DO-WITHDRAW
            WHEN "5" PERFORM DO-TRANSFER
            WHEN "6" PERFORM DO-LOANPAY
            WHEN "7" PERFORM DO-LOANINQ
            WHEN "8" PERFORM DO-NEWACCT
            WHEN "X" MOVE "Y" TO W-DONE
            WHEN OTHER
                MOVE "ENTER 1-8 OR X" TO SC-MSG
                PERFORM PUT-MESSAGE
        END-EVALUATE
    END-PERFORM
    PERFORM CLOSE-ALL
    GOBACK.

      *> ---- sign-on ------------------------------------------------------
      *> Nothing is readable or writable until an operator is identified,
      *> and the limits that come back decide which transactions will need
      *> a supervisor's authorisation further down the line.
SIGN-ON.
    MOVE 0 TO LG-RC
    PERFORM UNTIL LG-RC = 0 OR W-DONE = "Y"
        MOVE SCA-CLS TO SC-ACTION
        CALL "MBSCRN" USING SCRCOMM
        MOVE SCA-HDR TO SC-ACTION
        CALL "MBSCRN" USING SCRCOMM
        MOVE 6 TO SC-ROW
        MOVE "MERIDIAN TRUST COMPANY" TO SC-IN
        MOVE "B" TO SC-ATTR
        MOVE SCA-LINE TO SC-ACTION
        CALL "MBSCRN" USING SCRCOMM
        MOVE 8 TO SC-ROW
        MOVE "OPERATOR ID  : " TO SC-MSG
        MOVE SCA-FLD TO SC-ACTION
        CALL "MBSCRN" USING SCRCOMM
        MOVE FUNCTION UPPER-CASE(FUNCTION TRIM(SC-IN)) TO LG-ID
        MOVE SPACES TO SC-IN
        MOVE 10 TO SC-ROW
        MOVE "PASSWORD     : " TO SC-MSG
        MOVE SCA-FLD TO SC-ACTION
        CALL "MBSCRN" USING SCRCOMM
        MOVE FUNCTION UPPER-CASE(FUNCTION TRIM(SC-IN)) TO LG-PASSWD
        MOVE SPACES TO SC-IN
        MOVE LG-FN-ON TO LG-FUNC
        CALL "MBLOGN" USING LOGCOMM
        IF LG-RC NOT = 0
            MOVE LG-MSG TO SC-MSG
            MOVE "R" TO SC-ATTR
            MOVE SCA-FTR TO SC-ACTION
            CALL "MBSCRN" USING SCRCOMM
            MOVE "TRY AGAIN (Y/N) : " TO SC-MSG
            MOVE SCA-YN TO SC-ACTION
            CALL "MBSCRN" USING SCRCOMM
            MOVE FUNCTION UPPER-CASE(FUNCTION TRIM(SC-IN)) TO W-YESNO
            MOVE SPACES TO SC-IN
            IF W-YESNO NOT = "Y"
                DISPLAY "sign-on abandoned"
                MOVE "Y" TO W-DONE
            END-IF
        END-IF
    END-PERFORM.

      *> ---- session context ---------------------------------------------
      *> The screen manager, the header and every posting request all read
      *> the operator identity from these fields.
PUT-SESSION-CONTEXT.
    MOVE LG-ID TO SC-USRID
    MOVE LG-ID TO BK-USRID
    MOVE LG-NAME TO SC-USRNM
    MOVE LG-NAME TO BK-USRNM
    MOVE BK-TERMID TO SC-TERMID
    MOVE LG-BRANCH TO SC-BRANCH
    MOVE LG-BRANCH TO BK-BRANCH
    MOVE LG-ID TO BK-TELLERID
    MOVE LG-ID TO PR-TELLER
    MOVE LG-ID TO PR-USER
    MOVE BK-TERMID TO PR-TERM
    MOVE LG-BRANCH TO PR-BRANCH
    MOVE CH-BRCH TO PR-CHANNEL
    MOVE LG-LEVEL TO SC-LEVEL
    MOVE LG-LEVEL TO PR-LEVEL
    MOVE LG-LIMIT TO SC-LIMIT
    MOVE LG-LIMIT TO PR-LIMIT
    MOVE LG-CASH-LIMIT TO PR-CASH-LIMIT
    MOVE BK-DATE TO SC-DATE
    MOVE BK-DATE TO PR-DATE
    MOVE BK-TIME TO SC-TIME
    MOVE BK-TIME TO PR-TIME
    IF LG-LEVEL >= TL-SUPERVISOR
        MOVE "A" TO SC-LIMITED
    ELSE
        MOVE "1" TO SC-LIMITED
    END-IF.

INIT-SESSION.
      *> the operator identity is set by PUT-SESSION-CONTEXT after sign-on,
      *> so nothing here is allowed to invent a teller id
    MOVE "TERM1" TO BK-TERMID
    ACCEPT BK-DATE FROM DATE YYYYMMDD
    ACCEPT BK-TIME FROM TIME
    MOVE "MBANMAIN" TO PR-PROG
    DISPLAY "init: opening datasets"
    OPEN I-O ACCT-FILE BAL-FILE CUST-FILE LOAN-FILE LNBAL-FILE
    DISPLAY "init: opened fs=" FS-ACCT " " FS-BAL " " FS-CUST " " FS-LOAN " " FS-LNBAL
    IF FS-ACCT NOT = "00"
        DISPLAY "CANNOT OPEN ACCOUNT DATASET, FS=" FS-ACCT
        MOVE 16 TO RETURN-CODE
        GOBACK
    END-IF.

CLOSE-ALL.
    CLOSE ACCT-FILE BAL-FILE CUST-FILE LOAN-FILE LNBAL-FILE.

      *> ---- main menu ----------------------------------------------------
SHOW-MENU.
    MOVE SCA-CLS TO SC-ACTION
    DISPLAY "   menu step 1"
    CALL "MBSCRN" USING SCRCOMM
    MOVE SCA-HDR TO SC-ACTION
    DISPLAY "   menu step 2"
    CALL "MBSCRN" USING SCRCOMM
    MOVE 4 TO SC-ROW
    MOVE "MAIN MENU" TO SC-IN
    MOVE "B" TO SC-ATTR
    DISPLAY "   menu step 3"
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 5 TO SC-ROW
    MOVE SCA-RULE TO SC-ACTION
    DISPLAY "   menu step 4"
    CALL "MBSCRN" USING SCRCOMM
    MOVE 7 TO SC-ROW
    MOVE "1.  BALANCE INQUIRY" TO SC-IN
    DISPLAY "   menu step 5"
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 8 TO SC-ROW
    MOVE "2.  CUSTOMER INQUIRY" TO SC-IN
    DISPLAY "   menu step 6"
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 9 TO SC-ROW
    MOVE "3.  CASH DEPOSIT" TO SC-IN
    DISPLAY "   menu step 7"
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 10 TO SC-ROW
    MOVE "4.  CASH WITHDRAWAL" TO SC-IN
    DISPLAY "   menu step 8"
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 11 TO SC-ROW
    MOVE "5.  TRANSFER BETWEEN ACCOUNTS" TO SC-IN
    DISPLAY "   menu step 9"
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 12 TO SC-ROW
    MOVE "6.  LOAN PAYMENT" TO SC-IN
    DISPLAY "   menu step 10"
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 13 TO SC-ROW
    MOVE "7.  LOAN INQUIRY" TO SC-IN
    DISPLAY "   menu step 11"
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 14 TO SC-ROW
    MOVE "8.  OPEN NEW ACCOUNT" TO SC-IN
    DISPLAY "   menu step 12"
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 16 TO SC-ROW
    MOVE "X.  END SESSION" TO SC-IN
    MOVE "Y" TO SC-ATTR
    DISPLAY "   menu step 13"
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 18 TO SC-ROW
    MOVE SCA-RULE TO SC-ACTION
    DISPLAY "   menu step 14"
    CALL "MBSCRN" USING SCRCOMM
    MOVE "PF KEYS NOT IN USE - TYPE THE NUMBER" TO SC-MSG
    PERFORM PUT-MESSAGE
    MOVE 20 TO SC-ROW
    MOVE 3 TO SC-COL
    MOVE SCA-SHOW TO SC-ACTION
    DISPLAY "   menu step 15"
    CALL "MBSCRN" USING SCRCOMM
    MOVE 20 TO SC-ROW
    MOVE 3 TO SC-COL
    MOVE "SELECTION: " TO SC-MSG
    MOVE SCA-FLD TO SC-ACTION
    DISPLAY "   menu step 16"
    CALL "MBSCRN" USING SCRCOMM
    MOVE SC-IN TO W-CHOICE
    MOVE SPACES TO SC-IN.

READ-CHOICE.
    MOVE FUNCTION UPPER-CASE(FUNCTION TRIM(W-CHOICE)) TO W-CHOICE.

PUT-MESSAGE.
    MOVE SCA-FTR TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM.

      *> ---- 1. balance inquiry -------------------------------------------
DO-BALANCE.
    MOVE SCA-CLS TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE SCA-HDR TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 4 TO SC-ROW
    MOVE "ACCOUNT INQUIRY" TO SC-IN
    MOVE "B" TO SC-ATTR
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 5 TO SC-ROW
    MOVE SCA-RULE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 7 TO SC-ROW
    MOVE "ACCOUNT NUMBER   : " TO SC-MSG
    MOVE SCA-FLD TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE SC-IN TO PR-ACCT
    MOVE SPACES TO SC-IN
    MOVE "LOOKING UP ACCOUNT" TO SC-MSG
    PERFORM PUT-MESSAGE
    MOVE PR-ACCT TO AC-NO
    READ ACCT-FILE
    IF FS-ACCT = "23"
        MOVE "NO SUCH ACCOUNT" TO SC-MSG
        PERFORM PUT-MESSAGE
        PERFORM PAUSE
        EXIT PARAGRAPH
    END-IF
    IF FS-ACCT NOT = "00"
        MOVE "I/O ERROR READING ACCOUNT" TO SC-MSG
        PERFORM PUT-MESSAGE
        PERFORM PAUSE
        EXIT PARAGRAPH
    END-IF
    MOVE AC-NO TO BA-NO
    READ BAL-FILE
    MOVE 9 TO SC-ROW
    MOVE "ACCOUNT NUMBER   : " TO SC-IN
    MOVE AC-NO TO SC-IN(18:10)
    MOVE "C" TO SC-ATTR
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 10 TO SC-ROW
    MOVE "CUSTOMER         : " TO SC-IN
    MOVE AC-CUST-ID TO SC-IN(18:10)
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 11 TO SC-ROW
    MOVE "CUSTOMER NAME    : " TO SC-IN
    MOVE AC-CUST-ID TO CU-ID
    READ CUST-FILE
    IF FS-CUST = "00"
        MOVE CU-NAME TO SC-IN(18:30)
    ELSE
        MOVE "NOT ON FILE" TO SC-IN(18:30)
    END-IF
    MOVE "C" TO SC-ATTR
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 12 TO SC-ROW
    MOVE "PRODUCT          : " TO SC-IN
    PERFORM TYPE-NAME
    MOVE W-TYPE-NM TO SC-IN(18:12)
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 13 TO SC-ROW
    MOVE "STATUS           : " TO SC-IN
    PERFORM STATUS-NAME
    MOVE W-STATUS-NM TO SC-IN(18:12)
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 15 TO SC-ROW
    MOVE "AVAILABLE BALANCE: " TO SC-IN
    MOVE BA-AVAIL TO W-BALED
    MOVE W-BALED TO SC-IN(18:14)
    MOVE "B" TO SC-ATTR
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 16 TO SC-ROW
    MOVE "LEDGER BALANCE   : " TO SC-IN
    MOVE BA-CURRENT TO W-BALED
    MOVE W-BALED TO SC-IN(18:14)
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 17 TO SC-ROW
    MOVE "HELD FUNDS       : " TO SC-IN
    MOVE BA-HOLD TO W-BALED
    MOVE W-BALED TO SC-IN(18:14)
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 18 TO SC-ROW
    MOVE "OVERDRAFT LIMIT  : " TO SC-IN
    MOVE AC-OD-LIMIT TO W-LIMED
    MOVE W-LIMED TO SC-IN(18:14)
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 19 TO SC-ROW
    MOVE "RETURNED ITEMS   : " TO SC-IN
    MOVE BA-NSF-CNT TO SC-IN(18:3)
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 20 TO SC-ROW
    MOVE "LAST POSTED      : " TO SC-IN
    MOVE BA-LAST-POST-DT TO SC-IN(18:8)
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE "PRESS ENTER TO RETURN" TO SC-MSG
    PERFORM PUT-MESSAGE
    MOVE 22 TO SC-ROW
    MOVE 3 TO SC-COL
    MOVE SCA-SHOW TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 22 TO SC-ROW
    MOVE 3 TO SC-COL
    MOVE SCA-FLD TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE SPACES TO SC-IN.

PAUSE.
    MOVE 22 TO SC-ROW
    MOVE 3 TO SC-COL
    MOVE SCA-SHOW TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 22 TO SC-ROW
    MOVE 3 TO SC-COL
    MOVE "PRESS ENTER TO CONTINUE" TO SC-MSG
    MOVE SCA-FLD TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE SPACES TO SC-IN.

      *> ---- 2. customer inquiry ------------------------------------------
DO-CUSTOMER.
    MOVE SCA-CLS TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE SCA-HDR TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 4 TO SC-ROW
    MOVE "CUSTOMER INQUIRY" TO SC-IN
    MOVE "B" TO SC-ATTR
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 7 TO SC-ROW
    MOVE "CUSTOMER NUMBER  : " TO SC-MSG
    MOVE SCA-FLD TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE SC-IN TO CU-ID
    MOVE SPACES TO SC-IN
    READ CUST-FILE
    IF FS-CUST = "23"
        MOVE "NO SUCH CUSTOMER" TO SC-MSG
        PERFORM PUT-MESSAGE
        PERFORM PAUSE
        EXIT PARAGRAPH
    END-IF
    MOVE 6 TO SC-ROW
    MOVE SCA-RULE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 8 TO SC-ROW
    MOVE "NAME             : " TO SC-IN
    MOVE CU-NAME TO SC-IN(18:30)
    MOVE "C" TO SC-ATTR
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 9 TO SC-ROW
    MOVE "ADDRESS          : " TO SC-IN
    MOVE CU-ADDR TO SC-IN(18:40)
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 10 TO SC-ROW
    MOVE "CITY / STATE     : " TO SC-IN
    MOVE CU-CITY TO SC-IN(18:20)
    MOVE " " TO SC-IN(38:1)
    MOVE CU-STATE TO SC-IN(39:2)
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 11 TO SC-ROW
    MOVE "POSTAL CODE      : " TO SC-IN
    MOVE CU-ZIP TO SC-IN(18:9)
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 12 TO SC-ROW
    MOVE "DATE OF BIRTH    : " TO SC-IN
    MOVE CU-DOB TO SC-IN(18:8)
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 13 TO SC-ROW
    MOVE "CUSTOMER SINCE   : " TO SC-IN
    MOVE CU-OPEN-DT TO SC-IN(18:8)
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 14 TO SC-ROW
    MOVE "HOME BRANCH      : " TO SC-IN
    MOVE CU-BRANCH TO SC-IN(18:4)
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 16 TO SC-ROW
    MOVE "PRESS ENTER TO RETURN" TO SC-MSG
    PERFORM PUT-MESSAGE
    MOVE 18 TO SC-ROW
    MOVE 3 TO SC-COL
    MOVE SCA-SHOW TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 18 TO SC-ROW
    MOVE 3 TO SC-COL
    MOVE "PRESS ENTER TO CONTINUE" TO SC-MSG
    MOVE SCA-FLD TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE SPACES TO SC-IN.

      *> ---- 3. deposit ---------------------------------------------------
DO-DEPOSIT.
    PERFORM CASH-SCREEN
    IF W-YESNO NOT = "Y"
        EXIT PARAGRAPH
    END-IF
    MOVE TT-DEP TO PR-TYPE
    MOVE "CASH DEPOSIT" TO PR-DESCR
    PERFORM POST-AND-REPORT.

      *> ---- 4. withdrawal ------------------------------------------------
DO-WITHDRAW.
    PERFORM CASH-SCREEN
    IF W-YESNO NOT = "Y"
        EXIT PARAGRAPH
    END-IF
    MOVE TT-WDL TO PR-TYPE
    MOVE "CASH WITHDRAWAL" TO PR-DESCR
    PERFORM POST-AND-REPORT.

      *> ---- shared cash window for deposit and withdrawal -----------------
CASH-SCREEN.
    MOVE SCA-CLS TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE SCA-HDR TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 4 TO SC-ROW
    MOVE SC-MSG TO SC-IN
    MOVE "B" TO SC-ATTR
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 5 TO SC-ROW
    MOVE SCA-RULE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 7 TO SC-ROW
    MOVE "ACCOUNT NUMBER   : " TO SC-MSG
    MOVE SCA-FLD TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE SC-IN TO PR-ACCT
    MOVE SPACES TO SC-IN
    MOVE PR-ACCT TO AC-NO
    READ ACCT-FILE
    IF FS-ACCT NOT = "00"
        MOVE "ACCOUNT NOT FOUND" TO SC-MSG
        PERFORM PUT-MESSAGE
        PERFORM PAUSE
        MOVE "N" TO W-YESNO
        EXIT PARAGRAPH
    END-IF
    MOVE AC-NO TO BA-NO
    READ BAL-FILE
    MOVE 9 TO SC-ROW
    MOVE "ACCOUNT         : " TO SC-IN
    MOVE AC-NO TO SC-IN(14:10)
    MOVE "C" TO SC-ATTR
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 10 TO SC-ROW
    MOVE "NAME            : " TO SC-IN
    MOVE AC-CUST-ID TO CU-ID
    READ CUST-FILE
    IF FS-CUST = "00"
        MOVE CU-NAME TO SC-IN(14:30)
    ELSE
        MOVE "NOT ON FILE" TO SC-IN(14:30)
    END-IF
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 11 TO SC-ROW
    MOVE "CURRENT BALANCE : " TO SC-IN
    MOVE BA-AVAIL TO W-BALED
    MOVE W-BALED TO SC-IN(14:14)
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 13 TO SC-ROW
    MOVE "AMOUNT          : " TO SC-MSG
    MOVE SCA-NUM TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE SC-NUM TO PR-AMOUNT
    MOVE SC-NUM TO W-AMT
    MOVE SPACES TO SC-IN
    MOVE 14 TO SC-ROW
    MOVE "AMOUNT ENTERED  : " TO SC-IN
    MOVE W-AMT TO W-AMTED
    MOVE W-AMTED TO SC-IN(14:14)
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 16 TO SC-ROW
    MOVE "CONFIRM (Y/N)   : " TO SC-MSG
    MOVE SCA-YN TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE FUNCTION UPPER-CASE(FUNCTION TRIM(SC-IN)) TO W-YESNO
    MOVE SPACES TO SC-IN
    MOVE "PRESS ENTER TO RETURN" TO SC-MSG
    PERFORM PUT-MESSAGE
    MOVE 18 TO SC-ROW
    MOVE 3 TO SC-COL
    MOVE SCA-SHOW TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM.

POST-AND-REPORT.
      *> clear only the response half: clearing POSTCOMM here destroyed the
      *> request the caller had just built and every posting failed with RC 48
    MOVE 0 TO PY-RC
    MOVE SPACES TO PY-MSG
    MOVE 0 TO PY-POSTED
    MOVE 0 TO PY-FEE-CHG
    MOVE 0 TO PY-SEQ
    MOVE 0 TO PY-OLD-BAL
    MOVE 0 TO PY-NEW-BAL
    MOVE "MBANMAIN" TO PR-PROG
    MOVE 1 TO PR-LOCK
    CALL "MBPOSTNG" USING POSTCOMM
    MOVE 6 TO SC-ROW
    MOVE SCA-RULE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 8 TO SC-ROW
    MOVE "RESULT          : " TO SC-IN
    MOVE PY-MSG TO SC-IN(18:56)
    MOVE "Y" TO SC-ATTR
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 9 TO SC-ROW
    MOVE "RETURN CODE     : " TO SC-IN
    MOVE PY-RC TO SC-IN(18:8)
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    IF PY-POSTED > 0
        MOVE 11 TO SC-ROW
        MOVE "PREVIOUS BALANCE: " TO SC-IN
        MOVE PY-OLD-BAL TO W-BALED
        MOVE W-BALED TO SC-IN(18:14)
    MOVE SCA-LINE TO SC-ACTION
        CALL "MBSCRN" USING SCRCOMM
        MOVE 12 TO SC-ROW
        MOVE "NEW BALANCE     : " TO SC-IN
        MOVE PY-NEW-BAL TO W-BALED
        MOVE W-BALED TO SC-IN(18:14)
        MOVE "B" TO SC-ATTR
    MOVE SCA-LINE TO SC-ACTION
        CALL "MBSCRN" USING SCRCOMM
        MOVE 13 TO SC-ROW
        MOVE "JOURNAL SEQUENCE: " TO SC-IN
        MOVE PY-SEQ TO SC-IN(18:12)
    MOVE SCA-LINE TO SC-ACTION
        CALL "MBSCRN" USING SCRCOMM
        MOVE PY-FEE-CHG TO W-AMT
        IF PY-FEE-CHG > 0
            MOVE 14 TO SC-ROW
            MOVE "CHARGE ASSESSED : " TO SC-IN
            MOVE W-AMT TO W-AMTED
            MOVE W-AMTED TO SC-IN(18:14)
            MOVE "Y" TO SC-ATTR
    MOVE SCA-LINE TO SC-ACTION
            CALL "MBSCRN" USING SCRCOMM
        END-IF
    END-IF
    MOVE "PRESS ENTER TO RETURN" TO SC-MSG
    PERFORM PUT-MESSAGE
    MOVE 22 TO SC-ROW
    MOVE 3 TO SC-COL
    MOVE SCA-SHOW TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 22 TO SC-ROW
    MOVE 3 TO SC-COL
    MOVE "PRESS ENTER TO CONTINUE" TO SC-MSG
    MOVE SCA-FLD TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE SPACES TO SC-IN.

      *> ---- 5. transfer ---------------------------------------------------
DO-TRANSFER.
    MOVE SCA-CLS TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE SCA-HDR TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 4 TO SC-ROW
    MOVE "TRANSFER BETWEEN ACCOUNTS" TO SC-IN
    MOVE "B" TO SC-ATTR
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 5 TO SC-ROW
    MOVE SCA-RULE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 7 TO SC-ROW
    MOVE "FROM ACCOUNT    : " TO SC-MSG
    MOVE SCA-FLD TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE SC-IN TO PR-ACCT
    MOVE SPACES TO SC-IN
    MOVE 8 TO SC-ROW
    MOVE "TO ACCOUNT      : " TO SC-MSG
    MOVE SCA-FLD TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE SC-IN TO PR-ACCT2
    MOVE SPACES TO SC-IN
    MOVE 9 TO SC-ROW
    MOVE "AMOUNT          : " TO SC-MSG
    MOVE SCA-NUM TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE SC-NUM TO PR-AMOUNT
    MOVE SPACES TO SC-IN
    MOVE 11 TO SC-ROW
    MOVE "FROM " TO SC-IN
    MOVE PR-ACCT TO SC-IN(5:10)
    MOVE "   TO " TO SC-IN(16:5)
    MOVE PR-ACCT2 TO SC-IN(21:10)
    MOVE "   AMOUNT " TO SC-IN(32:9)
    MOVE PR-AMOUNT TO W-AMTED
    MOVE W-AMTED TO SC-IN(41:14)
    MOVE "B" TO SC-ATTR
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 12 TO SC-ROW
    MOVE "CONFIRM (Y/N)   : " TO SC-MSG
    MOVE SCA-YN TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE FUNCTION UPPER-CASE(FUNCTION TRIM(SC-IN)) TO W-YESNO
    MOVE SPACES TO SC-IN
    IF W-YESNO NOT = "Y"
        EXIT PARAGRAPH
    END-IF
    MOVE TT-XFR TO PR-TYPE
    MOVE "TRANSFER" TO PR-DESCR
    PERFORM POST-AND-REPORT.

      *> ---- 6. loan payment ----------------------------------------------
DO-LOANPAY.
    MOVE SCA-CLS TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE SCA-HDR TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 4 TO SC-ROW
    MOVE "LOAN PAYMENT" TO SC-IN
    MOVE "B" TO SC-ATTR
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 5 TO SC-ROW
    MOVE SCA-RULE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 7 TO SC-ROW
    MOVE "LOAN NUMBER     : " TO SC-MSG
    MOVE SCA-FLD TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE SC-IN TO PR-LOANNO
    MOVE SPACES TO SC-IN
    MOVE PR-LOANNO TO LN-NO
    READ LOAN-FILE
    IF FS-LOAN NOT = "00"
        MOVE "LOAN NOT FOUND" TO SC-MSG
        PERFORM PUT-MESSAGE
        PERFORM PAUSE
        EXIT PARAGRAPH
    END-IF
    MOVE PR-LOANNO TO LB-NO
    READ LNBAL-FILE
    MOVE 9 TO SC-ROW
    MOVE "LOAN           : " TO SC-IN
    MOVE LN-NO TO SC-IN(14:12)
    MOVE "C" TO SC-ATTR
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 10 TO SC-ROW
    MOVE "PAYMENT ACCOUNT: " TO SC-IN
    MOVE LN-DISB-ACCT TO SC-IN(14:10)
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 11 TO SC-ROW
    MOVE "OUTSTANDING PRIN: " TO SC-IN
    MOVE LB-CUR-PRIN TO W-BALED
    MOVE W-BALED TO SC-IN(18:14)
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 12 TO SC-ROW
    MOVE "ACCRUED INTEREST: " TO SC-IN
    MOVE LB-CUR-INT TO W-BALED
    MOVE W-BALED TO SC-IN(18:14)
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 13 TO SC-ROW
    MOVE "MONTHLY PAYMENT : " TO SC-IN
    MOVE LN-PAYMENT TO W-BALED
    MOVE W-BALED TO SC-IN(18:14)
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 14 TO SC-ROW
    MOVE "AMOUNT TO PAY  : " TO SC-MSG
    MOVE SCA-NUM TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE SC-NUM TO PR-AMOUNT
    MOVE SPACES TO SC-IN
    MOVE 15 TO SC-ROW
    MOVE "CONFIRM (Y/N)   : " TO SC-MSG
    MOVE SCA-YN TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE FUNCTION UPPER-CASE(FUNCTION TRIM(SC-IN)) TO W-YESNO
    MOVE SPACES TO SC-IN
    IF W-YESNO NOT = "Y"
        EXIT PARAGRAPH
    END-IF
    MOVE AC-NO TO W-ROW
    MOVE LN-DISB-ACCT TO PR-ACCT
    MOVE TT-LOANPM TO PR-TYPE
    MOVE "LOAN PAYMENT" TO PR-DESCR
    PERFORM POST-AND-REPORT.

      *> ---- 7. loan inquiry ----------------------------------------------
DO-LOANINQ.
    MOVE SCA-CLS TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE SCA-HDR TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 4 TO SC-ROW
    MOVE "LOAN INQUIRY" TO SC-IN
    MOVE "B" TO SC-ATTR
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 7 TO SC-ROW
    MOVE "LOAN NUMBER     : " TO SC-MSG
    MOVE SCA-FLD TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE SC-IN TO PR-LOANNO
    MOVE SPACES TO SC-IN
    MOVE PR-LOANNO TO LN-NO
    READ LOAN-FILE
    IF FS-LOAN NOT = "00"
        MOVE "LOAN NOT FOUND" TO SC-MSG
        PERFORM PUT-MESSAGE
        PERFORM PAUSE
        EXIT PARAGRAPH
    END-IF
    MOVE PR-LOANNO TO LB-NO
    READ LNBAL-FILE
    MOVE 6 TO SC-ROW
    MOVE SCA-RULE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 8 TO SC-ROW
    MOVE "PRODUCT         : " TO SC-IN
    EVALUATE LN-TYPE
        WHEN "A" MOVE "AUTOMOBILE" TO SC-IN(18:12)
        WHEN "M" MOVE "MORTGAGE" TO SC-IN(18:12)
        WHEN "P" MOVE "PERSONAL" TO SC-IN(18:12)
        WHEN "C" MOVE "CARD LINE" TO SC-IN(18:12)
        WHEN OTHER MOVE "OTHER" TO SC-IN(18:12)
    END-EVALUATE
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 9 TO SC-ROW
    MOVE "DESCRIPTION     : " TO SC-IN
    MOVE LN-NMEMO TO SC-IN(18:40)
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 10 TO SC-ROW
    MOVE "ORIGINAL AMOUNT : " TO SC-IN
    MOVE LN-ORIGINAL TO W-BALED
    MOVE W-BALED TO SC-IN(18:14)
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 11 TO SC-ROW
    MOVE "OUTSTANDING     : " TO SC-IN
    MOVE LB-CUR-PRIN TO W-BALED
    MOVE W-BALED TO SC-IN(18:14)
    MOVE "B" TO SC-ATTR
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 12 TO SC-ROW
    MOVE "ACCRUED INTEREST: " TO SC-IN
    MOVE LB-CUR-INT TO W-BALED
    MOVE W-BALED TO SC-IN(18:14)
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 13 TO SC-ROW
    MOVE "ANNUAL RATE     : " TO SC-IN
    MOVE LN-RATE TO W-RATEED
    MOVE W-RATEED TO SC-IN(18:10)
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 14 TO SC-ROW
    MOVE "MONTHLY PAYMENT : " TO SC-IN
    MOVE LN-PAYMENT TO W-BALED
    MOVE W-BALED TO SC-IN(18:14)
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 15 TO SC-ROW
    MOVE "PAYMENTS MADE   : " TO SC-IN
    MOVE LB-PMTS-MADE TO SC-IN(18:4)
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 16 TO SC-ROW
    MOVE "NEXT DUE        : " TO SC-IN
    MOVE LB-NEXT-DUE-DT TO SC-IN(18:8)
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 17 TO SC-ROW
    MOVE "INTEREST PAID   : " TO SC-IN
    MOVE LB-PAID-INT TO W-BALED
    MOVE W-BALED TO SC-IN(18:14)
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 18 TO SC-ROW
    MOVE "PRINCIPAL PAID  : " TO SC-IN
    MOVE LB-PAID-PRIN TO W-BALED
    MOVE W-BALED TO SC-IN(18:14)
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 20 TO SC-ROW
    MOVE 3 TO SC-COL
    MOVE SCA-SHOW TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 20 TO SC-ROW
    MOVE 3 TO SC-COL
    MOVE "PRESS ENTER TO CONTINUE" TO SC-MSG
    MOVE SCA-FLD TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE SPACES TO SC-IN.

      *> ---- 8. open a new account ------------------------------------------
DO-NEWACCT.
    MOVE SCA-CLS TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE SCA-HDR TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 4 TO SC-ROW
    MOVE "OPEN NEW ACCOUNT" TO SC-IN
    MOVE "B" TO SC-ATTR
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 5 TO SC-ROW
    MOVE SCA-RULE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 7 TO SC-ROW
    MOVE "CUSTOMER NUMBER : " TO SC-MSG
    MOVE SCA-FLD TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE SC-IN TO AC-CUST-ID
    MOVE SPACES TO SC-IN
    READ ACCT-FILE
    MOVE AC-CUST-ID TO CU-ID
    READ CUST-FILE
    IF FS-CUST NOT = "00"
        MOVE "CUSTOMER NOT ON FILE" TO SC-MSG
        PERFORM PUT-MESSAGE
        PERFORM PAUSE
        EXIT PARAGRAPH
    END-IF
    MOVE 9 TO SC-ROW
    MOVE "CUSTOMER       : " TO SC-IN
    MOVE CU-NAME TO SC-IN(14:30)
    MOVE "C" TO SC-ATTR
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 11 TO SC-ROW
    MOVE "PRODUCT  C=CHECKING S=SAVINGS : " TO SC-MSG
    MOVE SCA-FLD TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE FUNCTION UPPER-CASE(FUNCTION TRIM(SC-IN)) TO W-CHOICE
    MOVE SPACES TO SC-IN
    IF W-CHOICE NOT = "C" AND W-CHOICE NOT = "S"
        MOVE "PRODUCT MUST BE C OR S" TO SC-MSG
        PERFORM PUT-MESSAGE
        PERFORM PAUSE
        EXIT PARAGRAPH
    END-IF
    MOVE 12 TO SC-ROW
    MOVE "OPENING BALANCE : " TO SC-MSG
    MOVE SCA-NUM TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE SC-NUM TO W-AMT
    MOVE SPACES TO SC-IN
    MOVE 13 TO SC-ROW
    MOVE "AMOUNT ENTERED  : " TO SC-IN
    MOVE W-AMT TO W-AMTED
    MOVE W-AMTED TO SC-IN(14:14)
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 15 TO SC-ROW
    MOVE "CONFIRM (Y/N)   : " TO SC-MSG
    MOVE SCA-YN TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE FUNCTION UPPER-CASE(FUNCTION TRIM(SC-IN)) TO W-YESNO
    MOVE SPACES TO SC-IN
    IF W-YESNO NOT = "Y"
        EXIT PARAGRAPH
    END-IF
      *> ---- allocate the next account number in the series --------------
    MOVE 0 TO AC-NO
    MOVE W-CHOICE TO AC-NO(1:1)
    PERFORM FIND-NEXT-ACCT
    IF W-ROW = 0
        MOVE "NO ACCOUNT NUMBER AVAILABLE" TO SC-MSG
        PERFORM PUT-MESSAGE
        PERFORM PAUSE
        EXIT PARAGRAPH
    END-IF
      *> product rules come from the parameter dataset, not from literals
    MOVE "MINBAL" TO W-PARM-NAME
    CALL "MBPARM" USING PARMCOMM
    MOVE W-CHOICE TO AC-TYPE
    MOVE "A" TO AC-STATUS
    MOVE "P PERSONAL CHECKING" TO AC-TITLE
    IF W-CHOICE = "S"
        MOVE "PASSBOOK SAVINGS" TO AC-TITLE
        MOVE "MINBAL-S" TO W-PARM-NAME
        CALL "MBPARM" USING PARMCOMM
        MOVE PM-VALUE TO AC-MIN-BAL
        MOVE "ODLIM-S" TO W-PARM-NAME
        CALL "MBPARM" USING PARMCOMM
        MOVE PM-VALUE TO AC-OD-LIMIT
        MOVE "RATE-S" TO W-PARM-NAME
        CALL "MBPARM" USING PARMCOMM
        MOVE PM-VALUE TO AC-INT-RATE
    ELSE
        MOVE PM-VALUE TO AC-MIN-BAL
        MOVE "ODLIM-C" TO W-PARM-NAME
        CALL "MBPARM" USING PARMCOMM
        MOVE PM-VALUE TO AC-OD-LIMIT
        MOVE "RATE-C" TO W-PARM-NAME
        CALL "MBPARM" USING PARMCOMM
        MOVE PM-VALUE TO AC-INT-RATE
    END-IF
    MOVE BK-DATE TO AC-OPEN-DT
    MOVE BK-BRANCH TO AC-BRANCH
    MOVE 0 TO AC-LTD-CRT
    MOVE 0 TO AC-PREV-BAL
    WRITE ACCT-REC
    IF FS-ACCT NOT = "00"
        MOVE "ACCOUNT WRITE FAILED, FS=" TO W-MSG1
        MOVE FS-ACCT TO W-MSG1(24:2)
        MOVE W-MSG1 TO SC-MSG
        PERFORM PUT-MESSAGE
        PERFORM PAUSE
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BAL-REC
    MOVE AC-NO TO BA-NO
    MOVE 0 TO BA-AVAIL
    MOVE 0 TO BA-CURRENT
    MOVE BK-DATE TO BA-LAST-POST-DT
    MOVE 0 TO BA-HOLD
    MOVE 0 TO BA-OVERDRAFT
    MOVE 0 TO BA-INT-ACCRUED
    MOVE 0 TO BA-NSF-CNT
    MOVE 0 TO BA-FEE-CNT
    WRITE BAL-REC
    IF FS-BAL NOT = "00"
        MOVE "BALANCE WRITE FAILED, FS=" TO W-MSG1
        MOVE FS-BAL TO W-MSG1(24:2)
        MOVE W-MSG1 TO SC-MSG
        PERFORM PUT-MESSAGE
        PERFORM PAUSE
        EXIT PARAGRAPH
    END-IF
      *> the opening deposit has to reach the ledger too
    MOVE "NEWACCT" TO PR-TYPE
    MOVE AC-NO TO PR-ACCT
    MOVE W-AMT TO PR-AMOUNT
    MOVE "OPENING DEPOSIT" TO PR-DESCR
    MOVE "Y" TO PR-AUTH
    PERFORM POST-AND-REPORT
    MOVE 6 TO SC-ROW
    MOVE SCA-RULE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 8 TO SC-ROW
    MOVE "ACCOUNT OPENED  : " TO SC-IN
    MOVE AC-NO TO SC-IN(18:10)
    MOVE "B" TO SC-ATTR
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 9 TO SC-ROW
    MOVE "OPENING BALANCE : " TO SC-IN
    MOVE W-AMT TO W-AMTED
    MOVE W-AMTED TO SC-IN(18:14)
    MOVE SCA-LINE TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 22 TO SC-ROW
    MOVE 3 TO SC-COL
    MOVE SCA-SHOW TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE 22 TO SC-ROW
    MOVE 3 TO SC-COL
    MOVE "PRESS ENTER TO CONTINUE" TO SC-MSG
    MOVE SCA-FLD TO SC-ACTION
    CALL "MBSCRN" USING SCRCOMM
    MOVE SPACES TO SC-IN.

      *> walk the series until an unused key turns up
      *> W-ROW comes back holding the free number, or 0 when the series is full
FIND-NEXT-ACCT.
    MOVE 0 TO W-ROW
    PERFORM VARYING W-NUM4 FROM 13 BY 1 UNTIL W-NUM4 > 99
        MOVE W-NUM4 TO AC-NO(2:4)
        MOVE "0000" TO AC-NO(6:4)
        MOVE "0" TO AC-NO(10:1)
        READ ACCT-FILE
        IF FS-ACCT = "23"
            MOVE W-NUM4 TO W-ROW
            EXIT PERFORM
        END-IF
    END-PERFORM.

      *> ---- small shared helpers ------------------------------------------
TYPE-NAME.
    EVALUATE AC-TYPE
        WHEN "C" MOVE "CHECKING" TO W-TYPE-NM
        WHEN "S" MOVE "SAVINGS" TO W-TYPE-NM
        WHEN "M" MOVE "MONEY MKT" TO W-TYPE-NM
        WHEN "L" MOVE "LINE OF CR" TO W-TYPE-NM
        WHEN OTHER MOVE "OTHER" TO W-TYPE-NM
    END-EVALUATE.

STATUS-NAME.
    EVALUATE AC-STATUS
        WHEN "A" MOVE "ACTIVE" TO W-STATUS-NM
        WHEN "D" MOVE "DORMANT" TO W-STATUS-NM
        WHEN "C" MOVE "CLOSED" TO W-STATUS-NM
        WHEN "F" MOVE "FROZEN" TO W-STATUS-NM
        WHEN OTHER MOVE "UNKNOWN" TO W-STATUS-NM
    END-EVALUATE.
